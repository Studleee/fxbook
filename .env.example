# OANDA credentials belong in SETTINGS, not here.
# Never commit tokens.

# gspread reads backend/credentials/google-service-account.json
# Pair spreadsheet links stay on the DESK sheets gear.
GOOGLE_SERVICE_ACCOUNT_FILE=backend/credentials/google-service-account.json

# Default worksheet / tab name if the gear is empty.
SHEET_TAB_DEFAULT=Trade Management

# Optional fallbacks if a pair has no link in the gear.
SHEET_ID_EUR_USD=
SHEET_ID_USD_CAD=
SHEET_ID_AUD_CHF=
SHEET_ID_AUD_JPY=
SHEET_ID_AUD_NZD=
SHEET_ID_EUR_GBP=
SHEET_ID_EUR_CHF=
SHEET_ID_GBP_USD=
SHEET_ID_USD_SGD=

# Optional. Cell bindings are universal (same A1 for every pair) in
# server/sheets_py/bindings.py — or saved from the sheets settings gear.
SHEETS_API_PORT=5174
